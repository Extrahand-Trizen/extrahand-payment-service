# Copy to .env and fill required secrets. This file highlights Play / dual test phones only.
#
# Postgres: set USE_DEV_POSTGRES to pick ONE database (never both).
#   USE_DEV_POSTGRES=true  → DEV_POSTGRESDB_URI
#   USE_DEV_POSTGRES=false → PROD_POSTGRESDB_URI
# USE_DEV_POSTGRES=true
# DEV_POSTGRESDB_URI=postgresql://...violet.../neondb?sslmode=require
# PROD_POSTGRESDB_URI=postgresql://...frost.../neondb?sslmode=require
# Optional legacy fallback if the selected URI above is unset:
# POSTGRESDB_URI=postgresql://.../neondb?sslmode=require
#
# Use sync:postgres-dev-to-prod to clone DEV data into PROD when needed.
#
# Use the SAME comma-separated list as extrahand-user-service PLAY_REVIEW_BYPASS_PHONES:
#   +919999999999 — test poster
#   +918888888888 — test tasker
# Escrow create skips Razorpay when metadata.posterPhone matches (last 10 digits).
#
# PLAY_REVIEW_BYPASS_PHONES=+919999999999,+918888888888
# Optional:
# PLAY_REVIEW_BYPASS_UIDS=<firebase_uid_poster>,<firebase_uid_tasker>

# Inter-service URLs
USER_SERVICE_URL=http://localhost:4001
TASK_SERVICE_URL=http://localhost:4002
MESSAGING_SERVICE_URL=http://localhost:4010
SERVICE_AUTH_TOKEN=your-shared-secret-token

# AES-256-GCM key for full bank account storage (32 bytes, base64). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BANK_ACCOUNT_ENCRYPTION_KEY=

# Production: record task-completion payouts in Postgres for ops portal (skip RazorpayX API).
# Defaults to true when NODE_ENV=production and this var is unset.
# PAYOUT_MANUAL_OPS_MODE=true

# Rewards / ExtraCoins (Phase 1 — v2 locked)
REWARDS_V2_ENABLED=true
EMIT_PAYMENT_COMPLETED_EVENTS=true
ROLE_BASED_WALLET_ENABLED=true
CUSTOMER_BOOKING_COIN_CAP_ENABLED=true
TASKER_PLATFORM_FEE_COIN_CAP_ENABLED=true
USE_USER_SERVICE_REWARD_CONTEXT=true
