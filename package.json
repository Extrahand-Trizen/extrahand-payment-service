{
  "name": "extrahand-payment-service",
  "version": "1.0.0",
  "description": "Payment Service for ExtraHand Platform - Handles payments, escrow, and payouts",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed:categories": "ts-node src/scripts/seedCategoryFees.ts",
    "seed:admin": "ts-node --require dotenv/config src/scripts/seedAdminUser.ts",
    "seed:admin:prod": "ts-node --require dotenv/config src/scripts/seedAdminUser.ts --prod",
    "migrate:wallet-role:sql": "ts-node scripts/run-migrate-add-wallet-role.ts",
    "migrate:wallet-role:dry": "ts-node scripts/backfill-wallet-role.ts",
    "migrate:wallet-role:execute": "ts-node scripts/backfill-wallet-role.ts --execute",
    "migrate:coin-value-1-1": "ts-node scripts/migrate-coin-value-inr-to-one.ts",
    "migrate:coin-value-1-1:execute": "ts-node scripts/migrate-coin-value-inr-to-one.ts --execute",
    "prod": "NODE_ENV=production node dist/server.js",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "eslint src --ext .ts",
    "health": "curl -f http://localhost:4003/api/v1/health || exit 1",
    "test:bank-crypto": "node --require ts-node/register/transpile-only --test src/utils/bankFieldCrypto.test.ts src/utils/queryDateRange.test.ts",
    "migrate:bank-encryption": "ts-node --require dotenv/config scripts/run-bank-encryption-migration.ts",
    "sync:postgres-dev-to-prod": "ts-node --require dotenv/config scripts/sync-dev-postgres-to-prod.ts",
    "sync:category-fees-dev-to-prod": "ts-node --require dotenv/config scripts/sync-category-fees-dev-to-prod.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@types/pg": "^8.16.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "razorpay": "^2.9.2",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.1.0",
    "prisma": "7.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
